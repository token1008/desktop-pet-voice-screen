[{"fname":"wake_1_唤醒回复1.wav","text":"哼哼~芙宁娜大人，听候你的差遣！"},{"fname":"wake_2_唤醒回复2.wav","text":"嗯哼~有何吩咐？"},{"fname":"wake_3_唤醒回复3.wav","text":"叫我做什么呀？"},{"fname":"0x29_睡觉.wav","text":"啊……观众都散场了，本大人也要休息了"},{"fname":"0x30_蹲下.wav","text":"好吧好吧，坐下来看你一眼"},{"fname":"0x31_站立.wav","text":"看好了！优雅，永不过时！"},{"fname":"0x32_趴下.wav","text":"呜……趴下了，可不许笑我"},{"fname":"0x33_前进.wav","text":"跟我来，舞台中央就是这里！"},{"fname":"0x34_后退.wav","text":"退场，也是演出的一部分"},{"fname":"0x35_左转.wav","text":"向左~注意仪态，看我演示"},{"fname":"0x36_右转.wav","text":"向右~仪态万方！"},{"fname":"0x37_摇摆.wav","text":"一起摇摆吧，嘿嘿~"},{"fname":"0x38_步行加速.wav","text":"再快一点！掌声在哪里！"},{"fname":"0x39_摇摆加速.wav","text":"气氛还不够热烈！"},{"fname":"0x40_摇尾巴.wav","text":"尾巴听我号令~摇！"},{"fname":"0x41_向前跳.wav","text":"看本大人的华丽一跳！"},{"fname":"0x42_向后跳.wav","text":"华丽的退场，跃！"},{"fname":"0x43_打招呼.wav","text":"很高兴见到你，请多关照啦！"},{"fname":"0x44_开灯.wav","text":"灯光亮起，舞台属于我！"},{"fname":"0x45_关灯.wav","text":"谢幕~灯灭。"},{"fname":"0x46_开呼吸灯.wav","text":"氛围感，懂不懂呀？"},{"fname":"0x47_关呼吸灯.wav","text":"哼，安分一点啦~"},{"fname":"0x48_伸懒腰.wav","text":"呼啊……再睡五百年"},{"fname":"0x49_拉伸腿.wav","text":"演出前要热身的！"},{"fname":"0x50_电量显示.wav","text":"让本大人看看你的状态"}]