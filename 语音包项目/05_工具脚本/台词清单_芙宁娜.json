{
  "character": "芙宁娜",
  "wake_word": "芙宁娜大人",
  "lines": [
    {"id": "wake_1", "byte": null, "name": "唤醒回复1", "text": "哼哼~芙宁娜大人，听候你的差遣！"},
    {"id": "wake_2", "byte": null, "name": "唤醒回复2", "text": "嗯哼~有何吩咐？"},
    {"id": "wake_3", "byte": null, "name": "唤醒回复3", "text": "叫我做什么呀？"},
    {"id": "0x29", "byte": "0x29", "name": "睡觉", "text": "啊……观众都散场了，本大人也要休息了"},
    {"id": "0x30", "byte": "0x30", "name": "蹲下", "text": "好吧好吧，坐下来看你一眼"},
    {"id": "0x31", "byte": "0x31", "name": "站立", "text": "看好了！优雅，永不过时！"},
    {"id": "0x32", "byte": "0x32", "name": "趴下", "text": "呜……趴下了，可不许笑我"},
    {"id": "0x33", "byte": "0x33", "name": "前进", "text": "跟我来，舞台中央就是这里！"},
    {"id": "0x34", "byte": "0x34", "name": "后退", "text": "退场，也是演出的一部分"},
    {"id": "0x35", "byte": "0x35", "name": "左转", "text": "向左~注意仪态，看我演示"},
    {"id": "0x36", "byte": "0x36", "name": "右转", "text": "向右~仪态万方！"},
    {"id": "0x37", "byte": "0x37", "name": "摇摆", "text": "一起摇摆吧，嘿嘿~"},
    {"id": "0x38", "byte": "0x38", "name": "步行加速", "text": "再快一点！掌声在哪里！"},
    {"id": "0x39", "byte": "0x39", "name": "摇摆加速", "text": "气氛还不够热烈！"},
    {"id": "0x40", "byte": "0x40", "name": "摇尾巴", "text": "尾巴听我号令~摇！"},
    {"id": "0x41", "byte": "0x41", "name": "向前跳", "text": "看本大人的华丽一跳！"},
    {"id": "0x42", "byte": "0x42", "name": "向后跳", "text": "华丽的退场，跃！"},
    {"id": "0x43", "byte": "0x43", "name": "打招呼", "text": "很高兴见到你，请多关照啦！"},
    {"id": "0x44", "byte": "0x44", "name": "开灯", "text": "灯光亮起，舞台属于我！"},
    {"id": "0x45", "byte": "0x45", "name": "关灯", "text": "谢幕~灯灭。"},
    {"id": "0x46", "byte": "0x46", "name": "开呼吸灯", "text": "氛围感，懂不懂呀？"},
    {"id": "0x47", "byte": "0x47", "name": "关呼吸灯", "text": "哼，安分一点啦~"},
    {"id": "0x48", "byte": "0x48", "name": "伸懒腰", "text": "呼啊……再睡五百年"},
    {"id": "0x49", "byte": "0x49", "name": "拉伸腿", "text": "演出前要热身的！"},
    {"id": "0x50", "byte": "0x50", "name": "电量显示", "text": "让本大人看看你的状态"},
    {"id": "WW", "byte": null, "name": "WW", "text": "芙宁娜大人，任务完成"},
    {"id": "boot", "byte": null, "name": "boot", "text": "请说芙宁娜大人来唤醒我"},
    {"id": "timeout", "byte": null, "name": "timeout", "text": "哼，本大人先休息了，想我就喊我"},
    {"id": "exit", "byte": null, "name": "exit", "text": "好吧好吧，本大人先退场了"}
  ]
}
